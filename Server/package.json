{
  "name": "job-hunt-server",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @jobhunt/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "npm start -w @jobhunt/server",
    "reset-profile": "npm run reset-profile -w @jobhunt/server",
    "show-profile": "npm run show-profile -w @jobhunt/server --"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
