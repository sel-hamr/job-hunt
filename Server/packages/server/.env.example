# Copy this file to .env and change the values.
# .env is never committed (it is in .gitignore).

# Where the SQLite file lives. A short path starts from packages/server/.
# Remove this line to use the default: packages/server/data/jobs.sqlite
DB_PATH=./data/jobs.sqlite

# The dashboard's address. Tools that change the profile answer with a review link to it.
DASHBOARD_URL=http://localhost:3000

# Which door: stdio (default, Claude Desktop starts the server) or http (the server runs by itself).
# TRANSPORT=http

# HTTP only. HOST stays 127.0.0.1 (only this computer). The dashboard uses port 3000.
# HOST=127.0.0.1
# PORT=3001

# HTTP only, and needed for it: the MCP token (a password, 32+ characters).
# AI apps send it as "Authorization: Bearer <token>". Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_TOKEN=
